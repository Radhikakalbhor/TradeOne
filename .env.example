# Security
SECRET_KEY=nationaldepo-super-secure-secret-key-change-in-prod-2026
SESSION_SECRET=nationaldepo-session-encryption-key-32-chars-long!
ADMIN_PASSWORD=adminsecret123
INGEST_API_KEY=nd-ingest-secret-key-2026

# Google OAuth (Optional - leave blank for dev testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft OAuth (Optional - leave blank for dev testing)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# SMTP Email Configuration (Optional - OTP_DEV_MODE will print to console and UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nationaldepo.sim

# Depository Settings
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10
CONSENT_DEFAULT_DAYS=90
SEED_STARTER_ACCOUNTS=true

# Access Control (Optional comma-separated lists)
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# API & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
BASE_URL=http://localhost:8000
