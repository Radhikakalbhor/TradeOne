# Deployment Environment (development / production)
ENVIRONMENT=development

# Security — replace all values before deploying to production
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
SESSION_SECRET=change-me-to-a-random-session-secret-32-chars
ADMIN_PASSWORD=change-me-admin-password
INGEST_API_KEY=change-me-ingest-api-key

# Google OAuth (Optional — leave blank to use Email OTP only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Email Delivery Configuration
# Provider selection: 'gmail' (recommended zero-cost for arbitrary recipients), 'resend', or 'smtp'. Leave blank to auto-detect.
EMAIL_PROVIDER=gmail

# 1. Official Gmail API via HTTPS (Recommended for Render Free — zero cost, sends to any recipient from hacksmiths360@gmail.com)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=hacksmiths360@gmail.com

# 2. Resend HTTPS API (Alternative HTTPS provider — sandbox limited to account owner without custom domain)
RESEND_API_KEY=
RESEND_FROM=TradeOne <onboarding@resend.dev>

# 3. SMTP Email Configuration (Optional fallback for local or non-restricted environments — ports 25/465/587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Depository Settings
DEMO_MODE=false
OTP_DEV_MODE=false
OTP_EXPIRY_MINUTES=10
CONSENT_DEFAULT_DAYS=90
SEED_STARTER_ACCOUNTS=false

# Access Control (Optional comma-separated lists — leave blank to allow all)
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# API & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
BASE_URL=http://localhost:8000

# Cross-Broker Sandbox & Shared Identity
SHARED_IDENTITY_SALT=your-shared-salt-across-all-4-brokers
INTERNAL_API_KEY=your-secure-internal-api-key
INTERNAL_API_ENABLED=true
SEED_STARTER_PORTFOLIO=false
STARTING_FUNDS=1000000.0
TRADEONE_URL=https://tradeone.onrender.com
PROVIDER_CODE=tradeone
DP_NAME=TradeOne Depository
DP_ID=IN300000

# Deployed Broker Providers (External APIs)
# NOTE: Set each broker's internal API key below. If left blank, TradeOne falls back to INTERNAL_API_KEY.
NIFTYTRADE_URL=https://nifty-50-5nzz.onrender.com
NIFTYTRADE_INTERNAL_KEY=
BHARATINVEST_URL=https://bharatinvest.onrender.com
BHARATINVEST_INTERNAL_KEY=
BONDBAZAAR_URL=https://bondbazaar-1.onrender.com
BONDBAZAAR_INTERNAL_KEY=
DEMO_AUTO_LINK=false
PUBLIC_BASE_URL=https://tradeone.onrender.com
