# Security — replace all values before deploying to production
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
SESSION_SECRET=change-me-to-a-random-session-secret-32-chars
ADMIN_PASSWORD=change-me-admin-password
INGEST_API_KEY=change-me-ingest-api-key

# Google OAuth (Optional — leave blank to use Email OTP only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# SMTP Email Configuration (Optional — OTP_DEV_MODE prints codes to console/UI when blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Depository Settings
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10
CONSENT_DEFAULT_DAYS=90
SEED_STARTER_ACCOUNTS=true

# Access Control (Optional comma-separated lists — leave blank to allow all)
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# API & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
BASE_URL=http://localhost:8000
